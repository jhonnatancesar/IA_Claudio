# Configuração central do Claudião (TASK-002).
# Nenhum valor real aqui — apenas placeholders e os defaults já definidos pela
# especificação mestre. Formato (variáveis de ambiente) e nomes podem mudar quando a
# stack de implementação for escolhida (ver docs/OPEN_QUESTIONS.md, item 1); o que
# não muda são os campos e seus significados, que vêm da especificação.

# PostgreSQL local (docs/DATABASE.md)
CLAUDIAO_POSTGRES_HOST=localhost
CLAUDIAO_POSTGRES_PORT=5432
CLAUDIAO_POSTGRES_DB=claudiao
CLAUDIAO_POSTGRES_USER=
CLAUDIAO_POSTGRES_PASSWORD=

# Chave mestra de criptografia, fora do banco (docs/SECURITY.md)
CLAUDIAO_MASTER_KEY_PATH=

# Runtime de modelo local (docs/ARCHITECTURE.md) — Ollama é apenas o runtime inicial;
# o modelo definitivo ainda não foi escolhido (docs/OPEN_QUESTIONS.md, item 3).
CLAUDIAO_LLM_RUNTIME=ollama
CLAUDIAO_OLLAMA_HOST=http://localhost:11434
CLAUDIAO_ACTIVE_MODEL=

# Logging (docs/OBSERVABILITY.md) — DEBUG desativado por padrão; rotação em
# arquivo local implementada na TASK-005 (backend/app/observability/logging_config.py)
CLAUDIAO_LOG_LEVEL=INFO
CLAUDIAO_LOG_DIR=logs
CLAUDIAO_LOG_FILE=claudiao.log

# Janela de contexto (docs/ORCHESTRATOR.md) — mudança exige reinicialização.
CLAUDIAO_CONTEXT_WINDOW_TOKENS=
CLAUDIAO_CONTEXT_WINDOW_WARN_PERCENT=80

# Limites de execução do orquestrador (docs/ORCHESTRATOR.md)
CLAUDIAO_MAX_STEPS=10

# Memória — limite fixo por usuário/aplicação (docs/MEMORY.md); valor exato definido
# na implementação da TASK-050, não aqui.
CLAUDIAO_MEMORY_LIMIT_PER_SCOPE=

# Cotas (docs/QUOTAS.md)
CLAUDIAO_QUOTA_CYCLE=daily
CLAUDIAO_QUOTA_WARN_PERCENT=80
CLAUDIAO_QUOTA_CRITICAL_PERCENT=95
CLAUDIAO_QUOTA_BLOCK_PERCENT=100

# Sessão administrativa (docs/PANEL.md) — logout por inatividade, tempo fixo na V1;
# valor exato a definir na implementação de TASK-122.
CLAUDIAO_ADMIN_SESSION_TIMEOUT_MINUTES=

# Janela de atualização noturna (docs/UPDATER.md)
CLAUDIAO_UPDATE_WINDOW_START=00:00
CLAUDIAO_UPDATE_WINDOW_END=03:00
